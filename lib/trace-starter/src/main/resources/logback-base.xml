<?xml version="1.0" encoding="UTF-8"?>
<included>
    <!-- Spring Boot Logback 설정 로드 -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml" />

    <!-- 텍스트 로깅 패턴 -->
    <property name="CONSOLE_TEXT_PATTERN" 
              value="%clr(%d{HH:mm:ss.SSS}){faint} [%clr(${HOSTNAME:-localhost}){green}:%clr(${PID:- }){magenta}] %clr([%15.15t]){faint} %clr(---){faint} %clr(%-35.35(%logger{30}:%L)){cyan} %clr(%5p) %clr([%X{traceId:-SYSTEM}]){faint} %m %clr(from %X{clientIp:-unknown} / %X{userAgent:-unknown}){faint}%n${LOG_EXCEPTION_CONVERSION_WORD:-%wEx}" />

    <!-- Console Text Appender -->
    <appender name="CONSOLE_TEXT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_TEXT_PATTERN}</pattern>
            <charset>utf8</charset>
        </encoder>
    </appender>

    <!-- Console JSON Appender -->
    <!-- MDC에 담긴 모든 정보(timestamp, traceId 등)가 자동으로 JSON 필드에 포함됩니다. -->
    <!-- 주의: net.logstash.logback:logstash-logback-encoder 의존성이 필요합니다. -->
    <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder" />
    </appender>
</included>
